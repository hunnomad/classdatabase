{
  "name": "hunnomad/classdatabase",
  "description": "Lightweight multi-driver database wrapper (PDO, MongoDB, Redis) with simple CRUD, rawQuery and transaction helpers.",
  "type": "library",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "HunNomad\\Database\\": "src/"
    }
  },
  "require": {
    "php": ">=8.0",
    "ext-pdo": "*",
    "mongodb/mongodb": "^1.19 || ^2.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0"
  },
  "suggest": {
    "ext-redis": "Required for the 'redis' driver (phpredis 6.3+ for PHP 8.5)",
    "ext-pdo_mysql": "Required for the 'mysql' driver",
    "ext-pdo_pgsql": "Required for the 'pgsql' driver",
    "ext-pdo_sqlsrv": "Required for the 'mssql' / 'sqlsrv' driver",
    "ext-pdo_oci": "Required for the 'oracle' driver"
  },
  "authors": [
    {
      "name": "Zsolt Boszormenyi",
      "email": "hunnomad@gmail.com"
    }
  ]
}
